# Gemini (free tier) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase (free tier) — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string — this IS the "shared secret link".
# The app is reached at https://your-deploy-url/?key=<this value>
# Generate one with: openssl rand -hex 24
SHARED_SECRET=

# Note: the app's timezone (Asia/Jerusalem) is hardcoded in lib/timezone.ts,
# not read from an env var — there's no APP_TIMEZONE to set here.
